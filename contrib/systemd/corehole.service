[Unit]
Description=Corehole DNS filtering server
Documentation=https://github.com/bjhaid/corehole
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=corehole
Group=corehole
WorkingDirectory=/var/lib/corehole
ExecStart=/usr/local/bin/corehole serve --config /etc/corehole/corehole.yaml
Restart=on-failure
RestartSec=5s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ReadWritePaths=/var/lib/corehole
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
